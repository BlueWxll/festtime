# Configuration API Terra Nova (24H By Webcup 2026)
PORT=3000
API_KEY=votre_cle_api_ici

# Diffusion des messages à tous les habitants (D18) : code demandé pour publier ou lever un message.
# Sans cette variable, les messages restent sur l'appareil qui les crée (démonstration).
BROADCAST_CODE=choisissez_un_code

# Recommandations adaptées par IA (F31) : clé OpenRouter (https://openrouter.ai/keys).
# Sans cette variable, la plateforme affiche des recommandations de référence.
OPENROUTER_API_KEY=votre_cle_openrouter
# Modèle utilisé ; openrouter/free choisit un modèle gratuit disponible.
OPENROUTER_MODEL=openrouter/free
